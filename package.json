{
  "name": "myfinancial-mcp",
  "version": "1.0.0",
  "description": "MyFinancial Market Data MCP: NSE & BSE Indian stock market data for Claude and any MCP client, powered by Tapetide. 55 tools: live quotes, financials, technicals, 326-ratio screener, FII/DII flows, option chains & IV, company filings, IPOs, portfolio & watchlist.",
  "type": "module",
  "bin": {
    "myfinancial-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke-test.mjs",
    "check:catalog": "node scripts/check-catalog-parity.mjs",
    "prepublishOnly": "tsc"
  },
